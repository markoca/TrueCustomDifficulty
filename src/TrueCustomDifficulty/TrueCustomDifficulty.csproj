<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>Assets\true-custom-difficulty.ico</ApplicationIcon>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TrueCustomDifficulty</AssemblyName>
    <RootNamespace>TrueCustomDifficulty</RootNamespace>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
    <Version>0.9.26.82</Version>

    <!-- Release publish defaults: one self-contained Windows executable where possible. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded so the Nexus release does not need a Data directory. -->
    <EmbeddedResource Include="Data\parameters.json" LogicalName="TrueCustomDifficulty.Data.parameters.json" />
    <EmbeddedResource Include="Data\cfg-writer-baseline.json" LogicalName="TrueCustomDifficulty.Data.cfg-writer-baseline.json" />
