<Window x:Class="TrueCustomDifficulty.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TrueCustomDifficulty.ViewModels"
        xmlns:controls="clr-namespace:TrueCustomDifficulty.Controls"
        xmlns:infra="clr-namespace:TrueCustomDifficulty.Infrastructure"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="True Custom Difficulty"
        Icon="Assets/true-custom-difficulty.ico"
        Width="1440" Height="810"
        MinWidth="1152" MinHeight="648"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <infra:ResponsiveCardWidthConverter x:Key="ResponsiveCardWidthConverter" />

        <DataTemplate x:Key="ParameterCardTemplate" DataType="{x:Type vm:ParameterViewModel}">
                                                    <Border x:Name="ParameterCard"
                                                            PreviewMouseLeftButtonDown="ParameterCard_PreviewMouseLeftButtonDown"
                                                            Background="{StaticResource ParameterRowBrush}"
                                                            BorderThickness="0"
                                                            CornerRadius="3"
                                                            Margin="1,1"
                                                            Padding="9,6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Border x:Name="ModifiedIndicator"
                                                                    Grid.RowSpan="4"
                                                                    Width="2"
                                                                    HorizontalAlignment="Left"
                                                                    Margin="-9,1,0,1"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    Visibility="Collapsed" />
        
                                                            <Grid Grid.Row="0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
        
                                                                <TextBlock x:Name="ParameterLabel"
                                                                           Text="{Binding Label}"
                                                                           ToolTip="{Binding Label}"
                                                                           FontSize="11.5"
                                                                           FontWeight="Normal"
                                                                           Foreground="{StaticResource RadarMutedTextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="None"
                                                                           ClipToBounds="True"
                                                                           Margin="0,0,8,0" />
        
                                                                <Grid Grid.Column="1">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="16" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="16" />
                                                                    </Grid.ColumnDefinitions>
        
                                                                    <TextBlock x:Name="WheelHintMinus" Grid.Column="0" Text="-"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               FontSize="13" FontWeight="Bold"
                                                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                               Visibility="Collapsed" />
        
                                                                    <Border x:Name="CurrentValueBox" Grid.Column="1"
                                                                            Background="Transparent"
                                                                            Cursor="Hand"
                                                                            PreviewMouseWheel="CurrentValueBox_PreviewMouseWheel"
                                                                            PreviewMouseRightButtonDown="SliderControl_PreviewMouseRightButtonDown"
                                                                            BorderThickness="0"
                                                                            Padding="3,1">
                                                                        <TextBlock x:Name="CurrentValueText" Text="{Binding CurrentDisplay}"
                                                                                   Foreground="{StaticResource TextBrush}"
                                                                                   FontSize="12.5" FontWeight="SemiBold"
                                                                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
        
                                                                    <TextBlock x:Name="WheelHintPlus" Grid.Column="2" Text="+"
                                                                               Foreground="{StaticResource AccentBrush}"
                                                                               FontSize="13" FontWeight="Bold"
                                                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                               Visibility="Collapsed" />
                                                                </Grid>
        
                                                                <CheckBox x:Name="ToggleControl"
                                                                          Grid.Column="1"
                                                                          IsEnabled="{Binding IsControlEnabled}"
                                                                          Content="{Binding ToggleStateLabel}"
                                                                          Foreground="{StaticResource TextBrush}"
                                                                          FontWeight="SemiBold"
                                                                          IsChecked="{Binding CurrentBoolean, Mode=TwoWay}"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Right"
                                                                          Visibility="Collapsed" />
                                                            </Grid>
        
                                                            <Grid x:Name="TechnicalRow"
                                                                  Grid.Row="1"
                                                                  Margin="0"
                                                                  Visibility="Collapsed">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding TechnicalDisplay}"
                                                                           Foreground="{StaticResource MutedTextBrush}"
                                                                           FontSize="10"
                                                                           FontWeight="Normal"
                                                                           TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock x:Name="EffectiveValueText"
                                                                           Grid.Column="1" Text="{Binding EffectiveDisplay}"
                                                                           Foreground="{StaticResource RadarMutedTextBrush}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Margin="12,0,0,0" HorizontalAlignment="Right"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
        
                                                            <Grid x:Name="ControlRow" Grid.Row="2" Margin="0,3,0,0">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="18" />
                                                                </Grid.RowDefinitions>
        
                                                                <controls:AmmoDistributionRadar x:Name="AmmoDistributionRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                                Grid.Row="0"
                                                                                                Grid.RowSpan="2"
                                                                                                MinHeight="500"
                                                                                                Visibility="Collapsed"
                                                                                                Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:MutantDropRadar x:Name="MutantDropRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                          Grid.Row="0"
                                                                                          Grid.RowSpan="2"
                                                                                          MinHeight="530"
                                                                                          Visibility="Collapsed"
                                                                                          Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:AnomalyDamageRadar x:Name="AnomalyDamageRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                             Grid.Row="0"
                                                                                             Grid.RowSpan="2"
                                                                                             MinHeight="500"
                                                                                             Visibility="Collapsed"
                                                                                             Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:WorldLootRemovalRadar x:Name="WorldLootRemovalRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                                Grid.Row="0"
                                                                                                Grid.RowSpan="2"
                                                                                                MinHeight="455"
                                                                                                Visibility="Collapsed"
                                                                                                Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:MedicalHealingRadar x:Name="MedicalHealingRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                             Grid.Row="0"
                                                                                             Grid.RowSpan="2"
                                                                                             MinHeight="390"
                                                                                             Visibility="Collapsed"
                                                                                             Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:ActionCostsRadar x:Name="ActionCostsRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                        Grid.Row="0"
                                                                                        Grid.RowSpan="2"
                                                                                        MinHeight="475"
                                                                                        Visibility="Collapsed"
                                                                                        Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:ItemPriceScalersRadar x:Name="ItemPriceScalersRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                             Grid.Row="0"
                                                                                             Grid.RowSpan="2"
                                                                                             MinHeight="435"
                                                                                             Visibility="Collapsed"
                                                                                             Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:MutantHealthRadar x:Name="MutantHealthRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                       Grid.Row="0"
                                                                                       Grid.RowSpan="2"
                                                                                       MinHeight="500"
                                                                                       Visibility="Collapsed"
                                                                                       Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:HumanGroupSizeRadar x:Name="HumanGroupSizeRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                              Grid.Row="0"
                                                                                              Grid.RowSpan="2"
                                                                                              MinHeight="500"
                                                                                              Visibility="Collapsed"
                                                                                              Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:MutantGroupSizeRadar x:Name="MutantGroupSizeRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                               Grid.Row="0"
                                                                                               Grid.RowSpan="2"
                                                                                               MinHeight="650"
                                                                                               Visibility="Collapsed"
                                                                                               Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:SpecialAbilityCooldownRadar x:Name="SpecialAbilityCooldownRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                                 Grid.Row="0"
                                                                                                 Grid.RowSpan="2"
                                                                                                 MinHeight="505"
                                                                                                 Visibility="Collapsed"
                                                                                                 Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <controls:StashAmmoRadar x:Name="StashAmmoRadarControl"
                                                                                                PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                         Grid.Row="0"
                                                                                         Grid.RowSpan="2"
                                                                                         MinHeight="520"
                                                                                         Visibility="Collapsed"
                                                                                         Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />

                                                                <controls:DrunkennessControl x:Name="DrunkennessControl"
                                                                                             PreviewMouseLeftButtonDown="Radar_PreviewMouseLeftButtonDown"
                                                                                             Grid.Row="0"
                                                                                             Grid.RowSpan="2"
                                                                                             MinHeight="300"
                                                                                             Visibility="Collapsed"
                                                                                             Parameters="{Binding DataContext.AllParameters, RelativeSource={RelativeSource AncestorType=Window}}" />
        
                                                                <Slider x:Name="SliderControl"
                                                                        Grid.Row="0"
                                                                        IsEnabled="{Binding IsControlEnabled}"
                                                                        Minimum="{Binding Minimum}"
                                                                        Maximum="{Binding Maximum}"
                                                                        SmallChange="{Binding TickFrequency}"
                                                                        LargeChange="{Binding TickFrequency}"
                                                                        TickFrequency="{Binding TickFrequency}"
                                                                        IsSnapToTickEnabled="True"
                                                                        Value="{Binding CurrentNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                        PreviewMouseRightButtonDown="SliderControl_PreviewMouseRightButtonDown" />
        
                                                                <controls:VanillaMarkerBar x:Name="VanillaMarkerControl"
                                                                                           Grid.Row="1"
                                                                                           Height="18"
                                                                                           Margin="0,-1,0,0"
                                                                                           IsEnabled="{Binding IsControlEnabled}"
                                                                                           Tag="number"
                                                                                           Minimum="{Binding Minimum}"
                                                                                           Maximum="{Binding Maximum}"
                                                                                           Markers="{Binding VanillaMarkers}"
                                                                                           MarkerClicked="VanillaMarkerControl_MarkerClicked" />
        
                                                                <!-- Explicit discrete-choice slider. The selected value is shown in the card header;
                                                                     underneath the track we show only the vanilla difficulty reference positions. -->
                                                                <Grid x:Name="ChoiceSliderControl"
                                                                      Grid.Row="0"
                                                                      Grid.RowSpan="2">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="18" />
                                                                    </Grid.RowDefinitions>
                                                                    <Slider Grid.Row="0"
                                                                            IsEnabled="{Binding IsControlEnabled}"
                                                                            Minimum="{Binding ChoiceMinimum}"
                                                                            Maximum="{Binding ChoiceMaximum}"
                                                                            SmallChange="{Binding ChoiceTickFrequency}"
                                                                            LargeChange="{Binding ChoiceTickFrequency}"
                                                                            TickFrequency="{Binding ChoiceTickFrequency}"
                                                                            IsSnapToTickEnabled="True"
                                                                            Value="{Binding ChoiceIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                            PreviewMouseRightButtonDown="SliderControl_PreviewMouseRightButtonDown" />
                                                                    <controls:VanillaMarkerBar Grid.Row="1"
                                                                                               Height="18"
                                                                                               Margin="0,-1,0,0"
                                                                                               IsEnabled="{Binding IsControlEnabled}"
                                                                                               Tag="choice"
                                                                                               Minimum="{Binding ChoiceMinimum}"
                                                                                               Maximum="{Binding ChoiceMaximum}"
                                                                                               Markers="{Binding ChoiceMarkers}"
                                                                                               MarkerClicked="VanillaMarkerControl_MarkerClicked" />
                                                                </Grid>
        
                                                                <Grid x:Name="RangeControl" Grid.Row="0" Grid.RowSpan="2">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="17" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="17" />
                                                                    </Grid.RowDefinitions>
        
                                                                    <Grid Grid.Row="0">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="34" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="54" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="MIN" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                                                        <Slider Grid.Column="1"
                                                                                IsEnabled="{Binding IsControlEnabled}"
                                                                                Minimum="{Binding Minimum}"
                                                                                Maximum="{Binding Maximum}"
                                                                                SmallChange="{Binding TickFrequency}"
                                                                                LargeChange="{Binding TickFrequency}"
                                                                                TickFrequency="{Binding TickFrequency}"
                                                                                IsSnapToTickEnabled="True"
                                                                                Value="{Binding CurrentMinNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                PreviewMouseRightButtonDown="SliderControl_PreviewMouseRightButtonDown" />
                                                                        <TextBlock x:Name="RangeMinValueText" Grid.Column="2" Text="{Binding RangeMinDisplay}" Foreground="{StaticResource RadarMutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <controls:VanillaMarkerBar Grid.Row="1" Height="17" Margin="34,-1,54,0" IsEnabled="{Binding IsControlEnabled}" Tag="rangeMin" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Markers="{Binding VanillaMarkers}" MarkerClicked="VanillaMarkerControl_MarkerClicked" />
        
                                                                    <Grid Grid.Row="2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="34" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="54" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Text="MAX" Foreground="{StaticResource MutedTextBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                                                        <Slider Grid.Column="1"
                                                                                IsEnabled="{Binding IsControlEnabled}"
                                                                                Minimum="{Binding Minimum}"
                                                                                Maximum="{Binding Maximum}"
                                                                                SmallChange="{Binding TickFrequency}"
                                                                                LargeChange="{Binding TickFrequency}"
                                                                                TickFrequency="{Binding TickFrequency}"
                                                                                IsSnapToTickEnabled="True"
                                                                                Value="{Binding CurrentMaxNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                PreviewMouseRightButtonDown="SliderControl_PreviewMouseRightButtonDown" />
                                                                        <TextBlock x:Name="RangeMaxValueText" Grid.Column="2" Text="{Binding RangeMaxDisplay}" Foreground="{StaticResource RadarMutedTextBrush}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <controls:VanillaMarkerBar Grid.Row="3" Height="17" Margin="34,-1,54,0" IsEnabled="{Binding IsControlEnabled}" Tag="rangeMax" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Markers="{Binding VanillaMarkers}" MarkerClicked="VanillaMarkerControl_MarkerClicked" />
                                                                </Grid>
        
                                                            </Grid>
        
                                                            <TextBlock x:Name="PracticalQuantityText"
                                                                       Grid.Row="3"
                                                                       Visibility="Collapsed"
                                                                       Text="{Binding PracticalQuantityDisplay}"
                                                                       Foreground="{StaticResource MutedTextBrush}"
                                                                       FontSize="10"
                                                                       Margin="0,4,0,0"
                                                                       TextWrapping="Wrap">

                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
        
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsControlVisible}" Value="False">
                                                            <Setter TargetName="ParameterCard" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSlider}" Value="False">
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAmmoDistributionAnchor}" Value="True">
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="AmmoDistributionRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsStashAmmoAnchor}" Value="True">
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="StashAmmoRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMutantDropAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="MutantDropRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsIndividualAnomalyDamageAnchor}" Value="True">
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="AnomalyDamageRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWorldLootRemovalAnchor}" Value="True">
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="WorldLootRemovalRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMedicalHealingAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="MedicalHealingRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActionCostAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="ActionCostsRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsItemPriceScalerAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="ItemPriceScalersRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMutantHealthAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="MutantHealthRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHumanGroupSizeAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="HumanGroupSizeRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMutantGroupSizeAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="MutantGroupSizeRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSpecialAbilityCooldownAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SpecialAbilityCooldownRadarControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDrunkennessAnchor}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="SliderControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="VanillaMarkerControl" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="TechnicalRow" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="DrunkennessControl" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRange}" Value="False">
                                                            <Setter TargetName="RangeControl" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToggle}" Value="True">
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="ToggleControl" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="ControlRow" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsChoiceSlider}" Value="False">
                                                            <Setter TargetName="ChoiceSliderControl" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRange}" Value="True">
                                                            <Setter TargetName="CurrentValueBox" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="ParameterLabel" Property="FontWeight" Value="Bold" />
                                                            <Setter TargetName="ParameterLabel" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                            <Setter TargetName="ModifiedIndicator" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="CurrentValueText" Property="FontWeight" Value="ExtraBold" />
                                                            <Setter TargetName="CurrentValueText" Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                                            <Setter TargetName="EffectiveValueText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="RangeMinValueText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="RangeMaxValueText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="PracticalQuantityText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="ToggleControl" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAggregateRadarAnchor}" Value="True">
                                                            <Setter TargetName="ParameterCard" Property="Background" Value="Transparent" />
                                                            <Setter TargetName="ParameterCard" Property="BorderThickness" Value="0" />
                                                            <Setter TargetName="ParameterCard" Property="Padding" Value="0" />
                                                            <Setter TargetName="ParameterCard" Property="Margin" Value="0,2,0,8" />
                                                            <Setter TargetName="ModifiedIndicator" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsAggregateRadarAnchor}" Value="False" />
                                                                <Condition Binding="{Binding IsMouseOver, ElementName=ParameterCard}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="ParameterCard" Property="Background" Value="{StaticResource ParameterHoverBrush}" />
                                                            <Setter TargetName="ParameterLabel" Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        </MultiDataTrigger>
                                                        <Trigger SourceName="CurrentValueBox" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="CurrentValueText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="WheelHintMinus" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="WheelHintPlus" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsControlEnabled}" Value="False">
                                                            <Setter TargetName="ParameterCard" Property="Opacity" Value="0.48" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Fully themed custom title bar. -->
            <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid Width="38" Height="38" Margin="0,0,9,0">
                        <Viewbox Width="30" Height="30"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Canvas Width="34" Height="34">
                                <Path Fill="{StaticResource AccentBrush}"
                                      Data="M 14.5,12.67 L 10,4.88 A 14,14 0 0 1 24,4.88 L 19.5,12.67 A 5,5 0 0 0 14.5,12.67 Z" />
                                <Path Fill="{StaticResource AccentBrush}"
                                      Data="M 14.5,12.67 L 10,4.88 A 14,14 0 0 1 24,4.88 L 19.5,12.67 A 5,5 0 0 0 14.5,12.67 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="120" CenterX="17" CenterY="17" />
                                    </Path.RenderTransform>
                                </Path>
                                <Path Fill="{StaticResource AccentBrush}"
                                      Data="M 14.5,12.67 L 10,4.88 A 14,14 0 0 1 24,4.88 L 19.5,12.67 A 5,5 0 0 0 14.5,12.67 Z">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="240" CenterX="17" CenterY="17" />
                                    </Path.RenderTransform>
                                </Path>
                                <Ellipse Width="7" Height="7"
                                         Canvas.Left="13.5" Canvas.Top="13.5"
                                         Fill="{StaticResource AccentBrush}" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock Text="TRUE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="19" VerticalAlignment="Center" />
                    <TextBlock Text=" CUSTOM DIFFICULTY" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="-" Style="{StaticResource WindowButtonStyle}" Click="MinimizeWindow_Click" />
                    <Button Content="□" Style="{StaticResource WindowButtonStyle}" Click="MaximizeRestoreWindow_Click" />
                    <Button Content="×" Style="{StaticResource CloseWindowButtonStyle}" Click="CloseWindow_Click" FontSize="16" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="14,12,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CUSTOMIZE THE ZONE"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Keep your chosen vanilla difficulty and customize how it plays."
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Width="350" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Base Preset"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedReferenceDifficulty}"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Slider Minimum="0"
                            Maximum="3"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            SmallChange="1"
                            LargeChange="1"
                            Value="{Binding BasePresetIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Novice" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="1" Text="Stalker" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Veteran" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Master" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="2" Margin="12,0,12,0"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab}">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <Grid Background="{StaticResource WindowBackgroundBrush}">
                            <Grid.ColumnDefinitions>
                                <!-- Controls intentionally do not span the full window width. -->
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="330" />
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="ParametersList"
                                     Grid.Column="0"
                                     ItemsSource="{Binding ParametersView}"
                                     SelectedItem="{Binding SelectedParameter, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource ParameterCardTemplate}"
                                     Background="{StaticResource WindowBackgroundBrush}"
                                     BorderThickness="0"
                                     Margin="5,6,5,9"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="False">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <!-- Keep selection behavior, but remove the default Windows focus/selection chrome. -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsControlVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <infra:ResponsiveParameterGridPanel IsItemsHost="True"
                                                                            HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <!-- Sections are stacked vertically. Only controls inside a section use the grid. -->
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <StackPanel IsItemsHost="True" Orientation="Vertical" />
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <StackPanel HorizontalAlignment="Stretch">
                                                                <ContentPresenter Content="{TemplateBinding Content}"
                                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                  HorizontalAlignment="Stretch" />
                                                                <ItemsControl ItemsSource="{Binding Items}"
                                                                              ItemTemplate="{StaticResource ParameterCardTemplate}"
                                                                              HorizontalContentAlignment="Stretch">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <infra:ResponsiveParameterGridPanel IsItemsHost="True"
                                                                                                                HorizontalAlignment="Stretch" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5,18,4,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="48"
                                                            Height="1"
                                                            Margin="0,0,10,0"
                                                            HorizontalAlignment="Right"
                                                            Background="{StaticResource SectionAccentBrush}"
                                                            Opacity="0.42"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="{StaticResource RadarMutedTextBrush}"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextOptions.TextFormattingMode="Display" />
                                                    <Border Grid.Column="2"
                                                            Width="48"
                                                            Height="1"
                                                            Margin="10,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            Background="{StaticResource SectionAccentBrush}"
                                                            Opacity="0.42"
                                                            VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                
                            </ListBox>

                            <!-- Context/rationale panel. Uses the existing theme; only the layout changes. -->
                            <controls:IndustrialFrame Grid.Column="1"
                                                      Background="{StaticResource PanelBrush}"
                                                      BorderBrush="{StaticResource BorderBrush}"
                                                      AccentBrush="{StaticResource AccentBrush}"
                                                      TechnicalMarkBrush="{StaticResource BorderSoftBrush}"
                                                      AccentEdge="True"
                                                      TechnicalMarks="True"
                                                      ChamferSize="8"
                                                      Margin="9,6,5,9"
                                                      Padding="0">
                                <Grid>
                                <ScrollViewer Margin="17,12,13,11"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedParameter.Label}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Text="WHAT IT DOES"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Margin="0,2,0,5" />

                                        <TextBlock Text="{Binding SelectedParameter.RationaleDisplay}"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   LineHeight="17"
                                                   Margin="0,0,0,11" />

                                        <Border BorderThickness="0"
                                                Padding="0"
                                                Margin="0,14,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedParameter.HasValueMeaning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="WHAT THIS VALUE MEANS"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,5" />
                                                <TextBlock Text="{Binding SelectedParameter.ValueMeaning}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16" />
                                            </StackPanel>
                                        </Border>

                                        <Border BorderThickness="0"
                                                Padding="0"
                                                Margin="0,14,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedParameter.HasLogic}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="HIGHER / LOWER"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,5" />
                                                <TextBlock Text="{Binding SelectedParameter.Logic}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16" />
                                            </StackPanel>
                                        </Border>

                                        <Border BorderThickness="0"
                                                Padding="0"
                                                Margin="0,14,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedParameter.HasInteraction}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="WORKS WITH"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,5" />
                                                <TextBlock Text="{Binding SelectedParameter.Interaction}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16" />
                                            </StackPanel>
                                        </Border>

                                        <Border BorderThickness="0"
                                                Padding="0"
                                                Margin="0,14,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedParameter.HasEffectiveDamage}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="CURRENT RESULT"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Margin="0,0,0,5" />
                                                <TextBlock Text="{Binding SelectedParameter.EffectiveDetails}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16" />
                                            </StackPanel>
                                        </Border>

                                        <Border BorderThickness="0"
                                                Padding="0"
                                                Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TabSummary}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16"
                                                           Margin="0,0,0,7" />
                                                <TextBlock Text="{Binding SliderGuide}"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           TextWrapping="Wrap"
                                                           LineHeight="16" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                </Grid>
                            </controls:IndustrialFrame>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <Border Grid.Row="3"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,9" Margin="0,8,0,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Modified " Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ModifiedCount}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="   ·   Vanilla " Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="{Binding UntouchedCount}" FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox Width="190"
                                  Margin="0,0,7,0"
                                  ItemsSource="{Binding AvailablePresets}"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ToolTip="Presets from the portable Presets folder" />
                        <Button Content="Load Preset" Command="{Binding LoadPresetCommand}" />
                        <Button Content="Save Preset" Command="{Binding SavePresetCommand}" />
                        <Button Content="Reset Tab" Command="{Binding ResetCurrentTabCommand}" />
                        <Button Content="Reset All" Command="{Binding ResetAllCommand}" />
                        <Button Content="Build Mod" Command="{Binding BuildCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
