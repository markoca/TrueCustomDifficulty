  "philosophies": {
    "Anomaly Runner": {
      "identity": "A fast anomaly chaser: poltergeists, controllers, psi and anomaly-linked moves are nastier than ordinary wildlife; movement mistakes are slightly less lethal, storms more active, artifact hunting stays lucrative.",
      "guardrail": "Keep the single-artifact-per-spawn cap and existing artifact/economy bonuses; never make ordinary beasts hyper-aggressive."
    },
    "Field Medic": {
      "identity": "Survival-by-treatment: physical rushes are a little slower, but psi, telekinesis and anomalies remain meaningful injuries; medical logistics restock quickly, falls offer a small recovery margin.",
      "guardrail": "Keep native artifact count and the preexisting medical specialization; never turn every encounter into a harmless training fight."
    },
    "Hardcore+": {
      "identity": "Relentless Zone: all 53 mutant moves are high-threat, but dangerous signature moves peak at 3×; very short cover warning and delayed resupply compound the scarcity and lethal Master encounters.",
      "guardrail": "Do not give the player extra artifacts or fall protection; do not exceed native 3× limits."
    },
    "Hardcore": {
      "identity": "Punishing but learnable Master difficulty: elite predators, shockwaves, telekinesis and psi strike harder and more frequently; minor fauna do not copy the elites' rhythm.",
      "guardrail": "Never make Master-authored 2× attack moves easier than source; keep one artifact per spawn and full 100% fall damage."
    },
    "Immersive": {
      "identity": "Believable ecology rather than power fantasy: stalkers remain observant, ambush predators and anomaly phenomena feel distinct, weak scavengers remain weak, and the Zone replenishes more slowly.",
      "guardrail": "Preserve all 1× global special pacing, full fall damage, and a one-artifact yield."
    },
    "Mercenary": {
      "identity": "Paid operator: humans fight with grenades, suppression and flanks; supernatural threats and disarming mutants punish sloppy planning; contract money buys faster supply, not free artifacts.",
      "guardrail": "Keep Master-only escalation out of the Veteran profile; maintain the existing combat-accuracy and income role advantages."
    },
    "Mutant Hunter": {
      "identity": "High-risk trophy stalker: predators hunt actively, lairs breed quickly, unique monster attacks and phantom summons dominate while human tactics remain normal; ammo traders refill for repeated hunts.",
      "guardrail": "Do not enlarge artifact yields or make human enemies tactically faster; hunt rewards remain in mutant parts."
    },
    "Outcast": {
      "identity": "Exile in hostile territory: dangerous sentries, roaming creatures, bad weather and stretched stock force improvisation; rare finds are truly rare and mutant attack pressure has species character.",
      "guardrail": "No fall damage forgiveness, no sudden two-artifact payouts, no cheaper weapon economy."
    },
    "Scavenger": {
      "identity": "Patient scavenger: ordinary animals provide escape windows, the truly exotic monsters stay terrifying, guards lose track sooner, but supply and rare artifacts are scarce.",
      "guardrail": "No free extra loot or two-at-a-time artifacts; low fall damage reflects careful movement, not combat dominance."
    },
    "Smuggler": {
      "identity": "Black-market courier: movement and stealth win over firefights; human pursuers lose the trail, weather gives cover and hidden merchants replenish faster, but psi anomalies still threaten illicit routes.",
      "guardrail": "Keep scarcity in ordinary world loot and one artifact per pickup; never turn stealth into automatic immunity."
    },
    "Tactical": {
      "identity": "Technical gunfight specialist: pressure comes chiefly from intelligent human grenades, suppression and flank pressure; the sharper mutant rushes punish poor spacing, but artifact farming is not a perk.",
      "guardrail": "Retain low human HP, Veteran source baseline, original medical economy and single-artifact spawn."
    },
    "Wanderer": {
      "identity": "Lone explorer: low human density, slower settlements and uneven wildlife are offset by eerie supernatural hotspots, more volatile weather and slightly safer vertical exploration.",
      "guardrail": "Keep 1 artifact per spawn and human combat tactics calm; exploration risk remains, without flat 1.25× mutant attacks."
    }
  },
